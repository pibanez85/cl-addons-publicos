<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="l10n_cl_fe.TaxTotalsField" t-inherit="account.TaxTotalsField" t-inherit-mode="extension">
        <xpath expr="//tr[.//span[@name='amount_total']]" position="before">
            <tr t-if="'l10n_cl_retencion_amount_currency' in totals">
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label">Retención</label>
                </td>
                <td class="o_list_monetary">
                    <span name="l10n_cl_retencion" dir="ltr" style="white-space: nowrap;"
                          t-out="this.formatMonetary(totals.l10n_cl_retencion_amount_currency)"/>
                </td>
            </tr>
        </xpath>
    </t>

</templates>
