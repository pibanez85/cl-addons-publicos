<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_dte_caf_apicaf" model="ir.ui.view">
            <field name="name">dte.caf.apicaf.form</field>
            <field name="model">dte.caf.apicaf</field>
            <field name="group_ids" eval="[(4,ref('base.group_user'))]"/>
            <field name="arch" type="xml">
                  <form string="DTE CAF API EMISION FOLIOS">
                      <header>
                          <field
                              name="etapa"
                              widget="statusbar"
                              invisible="operacion != 'obtener'"
                          />
                          <field
                              name="reob_etapa"
                              widget="statusbar"
                              invisible="operacion != 'reobtener'"
                          />
                          <field
                              name="an_etapa"
                              widget="statusbar"
                              invisible="operacion != 'anular'"
                          />
                      </header>
                      <group>
                          <field name="operacion" widget="radio" />
                          <field name="company_id" />
                          <field
                              name="firma"
                              invisible="not company_id"
                              domain="[('user_ids', '=', uid), ('company_ids', '=', company_id)]"
                          />
                          <field
                              name="documentos"
                              invisible="not firma or not documentos"
                              readonly="True"
                              widget="many2many_tags"
                          />
                          <field name="id_peticion" invisible="True" />
                      </group>
                      <group invisible="id_peticion == 0">
                          <field
                              name="jdc_id"
                              domain="[('id', 'in', documentos)]"
                              invisible="not documentos"
                              options="{'no_create': True, 'no_open': True}"
                          />
                          <field name="sequence_id" invisible="True" />
                          <field
                              name="cod_docto"
                              domain="[('dte', '=', True)]"
                              invisible="not sequence_id"
                          />
                      </group>
                      <group
                          invisible="id_peticion == 0 or operacion != 'obtener'"
                          string="Recuerde emitir una cantidad que pueda gastar en un plazo máximo de 6 meses, ya que después de ese tiempo los CAF Vencen y deberá anular en la página del SII los Folios Vencidos"
                      >
                          <field name="folios_disp" invisible="not cod_docto" />
                          <field
                              name="max_autor"
                              invisible="not cod_docto or max_autor == -1"
                          />
                          <span invisible="not cod_docto or max_autor != -1">
                         Cantidad máxima no especificada
                     </span>
                          <field
                              name="cant_doctos"
                              invisible="not cod_docto or max_autor == 0"
                          />
                          <field name="api_max_autor" invisible="True" />
                          <field name="api_folios_disp" invisible="True" />
                      </group>
                      <group
                          invisible="id_peticion == 0 or operacion not in ['reobtener', 'anular']"
                      >
                          <field
                              name="lineas_disponibles"
                              widget="one2many_list"
                              mode="list"
                              context="{'default_apicaf_id': id}"
                          >
                              <list string="CAFs disponibles" editable="bottom">
                                  <field name="apicaf_id" invisible="True" />
                                  <field name="fecha" readonly="True" />
                                  <field name="inicial" readonly="True" />
                                  <field name="final" readonly="True" />
                                  <field name="cantidad" readonly="True" />
                                  <field name="selected" />
                                  <field name="sequence" invisible="True" />
                                  <field name="form_name" invisible="True" />
                                  <field name="caf_id" invisible="True" />
                              </list>
                          </field>
                      </group>
                      <group invisible="operacion not in ['reobtener', 'anular'] or not reob_has_next_page">
                          <field name="reob_page_number" readonly="True" />
                          <field name="reob_has_next_page" invisible="1" />
                          <button
                              string='Siguiente Página'
                              name="next_page_reob"
                              type="object"
                              class="btn-primary"
                          />
                      </group>
                      <div invisible="id_peticion == 0 or an_etapa != 'an_motivo'">
                        <group
                            string="Ingrese Rango a anular"
                        >
                            <field name="api_folio_ini" readonly='1' />
                            <field name="api_folio_fin" readonly='1' />
                        </group>
                            <div>
                                <ul>
                                    <li
                                    >Recordar de que debe ser rango continuado, incluso si hay documentos ya recibidos por el SII, se anularán solamente los que no esten recibidos</li>
                                    <li>Ejemplo:</li>
                                    <li>CAF de la secuencia 1 - 10</li>
                                    <li>Anular Solio folio 3 y 8 , pero 4,5,6,7 están recibidos</li>
                                    <li>Folio ini = 3 , folio fin = 8</li>
                                    <li>El SII anulará solamente los folios 3 y 8 </li>
                                    <li>NO se puede anular Folio ya recibido aunque sea incluído en el rango</li>
                                    <li
                                    >Para anular un folio recibido, debe seguir el procedimiento correspondiente al tipo de documento ( ejemplo, para factura crear una NC de tipo anula documento)</li>
                                </ul>
                            </div>
                        <group>
                            <field name="folio_ini" />
                            <field name="folio_fin" />
                            <field name="motivo" />
                        </group>
                      </div>
                      <group invisible="not message">
                          <field name="es_ban" invisible="1" />
                          <field name="message" readonly="True" />
                          <button
                              name="delist"
                              type="object"
                              string="Remover Bloqueo (Ban)"
                              invisible="not es_ban"
                          />
                      </group>
                      <footer>
                          <button
                              string='Obtener CAF'
                              name="obtener_caf"
                              type="object"
                              class="btn-primary"
                              invisible="etapa !='confirmar' and reob_etapa != 'reob_confirmar'"
                          />
                          <button
                              string='Anular Folios'
                              name="confirmar"
                              type="object"
                              class="btn-primary"
                              invisible="an_etapa != 'an_motivo'"
                          />
                          <button string="Cancelar" class="btn-default" special="cancel" />
                      </footer>
                  </form>
            </field>
        </record>
        <record id="action_apicaf_form" model="ir.actions.act_window">
            <field name="name">API Emisión de Folios</field>
            <field name="res_model">dte.caf.apicaf</field>
            <field name="view_id" ref="l10n_cl_fe.view_dte_caf_apicaf" />
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
