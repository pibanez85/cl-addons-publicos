<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_account_move_reversal" model="ir.ui.view">
            <field name="name">account.move.reversal.form</field>
            <field name="model">account.move.reversal</field>
            <field name="inherit_id" ref="account.view_account_move_reversal" />
            <field name="arch" type="xml">
                <form position="replace">
                    <form string="Reverse Journal Entry">
                        <field name="residual" invisible="True"/>
                        <field name="company_id" invisible="True"/>
                        <field name="move_ids" invisible="True"/>
                        <field name="move_type" invisible="True"/>
                        <group invisible="refund_method != 'cl_refund'">
                            <field name="tipo_nota" widget="radio" />
                        </group>
                        <group invisible="refund_method != 'cl_refund'">
                          <field name="cl_refund" widget="radio"/>
                        </group>
                        <group invisible="refund_method == 'cl_refund'">
                             <group invisible="move_type not in ['out_invoice', 'in_invoice']">
                                <field name="refund_method" widget="radio" readonly="residual == 0"/>
                             </group>
                             <group invisible="move_type not in ['out_invoice', 'in_invoice', 'some_invoice']">
                                <div invisible="refund_method != 'refund'" class="oe_grey" colspan="4">
                                   The credit note is created in draft and can be edited before being issued.
                                </div>
                                <div invisible="refund_method != 'cancel'" class="oe_grey" colspan="4">
                                   The credit note is auto-validated and reconciled with the invoice.
                                </div>
                                <div invisible="refund_method != 'modify'" class="oe_grey" colspan="4">
                                   The credit note is auto-validated and reconciled with the invoice.
                                   The original invoice is duplicated as a new draft.
                                </div>
                             </group>
                        </group>
                        <group>
                             <group>
                                 <field name="reason" invisible="move_type == 'entry'" required="move_type == 'entry'"/>
                             </group>
                             <group>
                                <field name="journal_id"/>
                                <field name="date" widget="date" required="1"/>
                             </group>
                        </group>
                        <footer>
                            <button string='Reverse' name="reverse_moves" type="object" class="btn-primary"/>
                            <button string="Cancel" class="btn-secondary" special="cancel"/>
                        </footer>
                    </form>
                </form>
            </field>
        </record>
    </data>
</odoo>
