<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="sii_dte_masive_send_wizard_form" model="ir.ui.view">
        <field name="name">SII WS Consult Wizard form</field>
        <field name="model">sii.dte.masive_send.wizard</field>
        <field name="arch" type="xml">
            <form string="SII DTE masive send Wizard">
                <group>
                    <field name="documentos" widget="one2many">
                        <list string="DTes a enviar" editable="bottom">
                            <field name="state" invisible="True" />
                            <field name="company_id" invisible="True" />
                            <field name="invoice_date" />
                            <field name="document_class_id" />
                            <field name="sii_document_number" />
                            <field name="name" />
                            <field name="partner_id" />
                            <field name="amount_total" />
                            <field name="sii_batch_number" readonly="False" />
                            <field name="sii_result" widget="badge"
                                decoration-muted="sii_result in ['draft', 'NoEnviado', 'Anulado']"
                                decoration-info="sii_result in ['Enviado', 'EnProceso', 'EnCola']"
                                decoration-success="sii_result in ['Proceso', 'Aceptado']"
                                decoration-danger="sii_result == 'Rechazado'"
                                decoration-warning="sii_result == 'Reparo'"/>
                        </list>
                    </field>
                    <field name="set_pruebas" invisible="1" />
                    <field name="numero_atencion" invisible="not set_pruebas" />
                </group>
                <footer>
                        <button string="Confirm" name="confirm" type="object" class="oe_highlight" />
                        or
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
            </form>
        </field>
    </record>

    <record id="action_account_invoice_send" model="ir.actions.act_window">
        <field name="name">Enviar Documentos al SII</field>
        <field name="res_model">sii.dte.masive_send.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="sii_dte_masive_send_wizard_form"/>
        <field name="target">new</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_view_types">list</field>
    </record>
  </data>
</odoo>
