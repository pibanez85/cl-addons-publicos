<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_cl_fe</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="101"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Facturación Electrónica" string="Facturación Electrónica" name="l10n_cl_fe" groups="account.group_account_manager">

                    <!-- Version Information -->
                    <block title="Versión de librería Facturación Electrónica" name="fe_version_block">
                        <setting string="Versión Instalada" help="Versión actual de la librería de facturación electrónica">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="fe_version" class="col-lg-3 o_light_label"/>
                                    <field name="fe_version" readonly="True"/>
                                </div>
                                <div class="row mt8">
                                    <span class="col-lg-3 o_light_label">Versión Requerida</span>
                                    <span>0.21.3</span>
                                </div>
                                <div class="text-muted" invisible="fe_version >= '0.21.3'" style="color:red !important">¡Debe Actualizar o verificar su versión instalada!</div>
                            </div>
                        </setting>
                    </block>

                    <!-- Digital Signatures -->
                    <block title="Configuración de Certificados y Firmas" name="fe_signatures_block">
                        <setting string="Firmas Electrónicas" help="Configure firmas electrónicas y usuarios autorizados a usarlas">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(l10n_cl_fe.action_sii_firma_form)d"
                                            icon="oi-arrow-right"
                                            type="action"
                                            string="Configurar Firmas Electrónicas"
                                            class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <!-- Sending Configuration -->
                    <block title="Configuración de Envíos" name="fe_sending_block">
                        <setting string="Método de Envío DTE" help="Método de envío después de validar">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="send_dte_method" class="col-lg-4 o_light_label"/>
                                    <field name="send_dte_method"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Auto Enviar DTE" help="Tiempo para auto enviar DTE al SII">
                            <field name="auto_send_dte"/>
                        </setting>
                        <setting string="Auto Enviar Email" help="Auto enviar email al cliente al enviar DTE">
                            <field name="auto_send_email"/>
                        </setting>
                        <setting string="Email Persistencia (Horas)" help="Reenviar email hasta que el cliente acepte" invisible="not auto_send_email">
                            <field name="auto_send_persistencia"/>
                        </setting>
                    </block>

                    <!-- Maintenance -->
                    <block title="Mantenedores" name="fe_maintenance_block">
                        <setting string="Archivos CAF" help="Listado de archivos CAF subidos">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(l10n_cl_fe.action_caf_files)d"
                                            icon="fa-folder-open"
                                            type="action"
                                            string="Ver Archivos CAF"
                                            class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Obtener Folios" help="Obtener folios directamente desde el SII">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(action_apicaf_form)d"
                                            string="Obtener Folios desde SII"
                                            type="action"
                                            class="btn-primary"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Cola de Envío" help="Cola de envío de documentos al SII">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(l10n_cl_fe.cola_envio)d"
                                            icon="oi-arrow-right"
                                            type="action"
                                            string="Cola de Envío"
                                            class="btn-link"/>
                                    <div invisible="cola_envio_sin_firma_count == 0">
                                        <span class="text-danger">⚠ </span>
                                        <field name="cola_envio_sin_firma_count" class="text-danger"/>
                                        <button
                                            name="%(l10n_cl_fe.action_cola_envio_sin_firma)d"
                                            type="action"
                                            string="sin firma — Asignar"
                                            class="btn-link text-danger"
                                        />
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting string="Envíos XML" help="Historial de envíos XML al SII">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(l10n_cl_fe.xml_envio)d"
                                            icon="oi-arrow-right"
                                            type="action"
                                            string="Envíos XML"
                                            class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Clases de Documento" help="Tipos de documentos tributarios electrónicos">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(l10n_cl_fe.act_sii_document_class)d"
                                            icon="oi-arrow-right"
                                            type="action"
                                            string="Clases de Documento"
                                            class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Tipos de Documento" help="Tipos de documento para referencias">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(l10n_cl_fe.act_sii_document_type)d"
                                            icon="oi-arrow-right"
                                            type="action"
                                            string="Tipos de Documento"
                                            class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Responsabilidades" help="Tipos de contribuyente (Responsabilidad tributaria)">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(l10n_cl_fe.act_sii_responsability)d"
                                            icon="oi-arrow-right"
                                            type="action"
                                            string="Responsabilidades"
                                            class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Tipos de Concepto" help="Tipos de concepto para documentos">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(l10n_cl_fe.act_sii_concept_type)d"
                                            icon="oi-arrow-right"
                                            type="action"
                                            string="Tipos de Concepto"
                                            class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Descripciones de Actividad" help="Descripciones de actividad económica">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(l10n_cl_fe.act_sii_activity_description)d"
                                            icon="oi-arrow-right"
                                            type="action"
                                            string="Descripciones de Actividad"
                                            class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Actividades Económicas" help="Giros comerciales (actividades económicas)">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(l10n_cl_fe.act_partner_activities)d"
                                            icon="oi-arrow-right"
                                            type="action"
                                            string="Actividades Económicas"
                                            class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Oficinas Regionales SII" help="Oficinas regionales del SII">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(l10n_cl_fe.act_sii_regional_offices)d"
                                            icon="oi-arrow-right"
                                            type="action"
                                            string="Oficinas Regionales SII"
                                            class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <!-- XML Reception -->
                    <block title="Recepción de Documentos" name="fe_reception_block">
                        <setting string="Email para Recepción DTE" help="Alias donde se recibirán los DTEs de proveedores">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="dte_email_id" class="col-lg-4 o_light_label"/>
                                    <field name="dte_email_id"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Método Recepción DTE" help="Opciones para la recepción de XML por defecto">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="dte_receipt_method" class="col-lg-4 o_light_label"/>
                                    <field name="dte_receipt_method"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <!-- Other Options -->
                    <block title="Configuraciones Adicionales" name="fe_additional_block">
                        <setting string="Medios de Pago Electrónicos" help="Medios de pago que actúan como Boleta Electrónica">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="medios_de_pago_electronico"
                                           options="{'no_create': True}"
                                           widget="many2many_tags"
                                           domain="[('type', 'not in', ['sale', 'purchase']), ('company_id', '=', company_id)]"/>
                                </div>
                                <div class="row mt16">
                                    <label for="medios_de_pago_internet" string="De ellos, por Internet" class="col-lg-4 o_light_label"/>
                                    <field name="medios_de_pago_internet"
                                           options="{'no_create': True}"
                                           widget="many2many_tags"
                                           domain="[('id', 'in', medios_de_pago_electronico)]"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Modelo de emisión de boleta" help="Según el atributo del contribuyente en el SII">
                            <field name="modelo_emision_boleta" widget="radio"/>
                            <div class="text-muted">
                                <ul>
                                    <li><b>Voucher</b> (por defecto en el SII): cada pago electrónico es un comprobante de pago (tipo 48) que vale como boleta; se emite boleta solo por efectivo o transferencia. Los pagos electrónicos de facturas se rebajan en el Registro de Compras y Ventas con el informe <i>Pagos electrónicos de facturas</i>.</li>
                                    <li><b>Boleta</b>: el voucher queda solo como comprobante de pago y siempre se emite boleta. Se cambia primero en el SII.</li>
                                </ul>
                                <a href="https://www4.sii.cl/actatributointernetui/#!/inicio" target="_blank">Consultar en el SII</a>
                            </div>
                        </setting>
                        <setting string="Acción por límite de líneas">
                            <field name="dte_lines_action"/>
                            <div class="text-muted">
                                <ul>
                                    <li><b>Auto Crear</b>: divide en varios documentos cuando el detalle no cabe en la hoja impresa.</li>
                                    <li><b>Detener</b>: bloquea el documento si el detalle excede la hoja impresa.</li>
                                    <li><b>Agrupar en el XML</b>: mantiene todas las líneas en el move y la hoja impresa, pero en el XML al SII agrupa por impuesto cuando se supera el máximo legal.</li>
                                </ul>
                            </div>
                        </setting>
                        <setting string="Líneas por hoja impresa" help="Cantidad de líneas que caben en la hoja impresa" invisible="dte_lines_action == 'autopack'">
                            <field name="dte_lines"/>
                        </setting>
                        <setting string="Factor de Cálculo Líneas" help="Factor para acomodar líneas largas" invisible="dte_lines_action == 'autopack'">
                            <field name="dte_lines_factor"/>
                        </setting>
                        <setting string="Sucursales DTE" help="Sucursales DTE de la empresa (Código SII)">
                            <button name="%(l10n_cl_fe.action_sii_sucursal)d"
                                    icon="fa-arrow-right"
                                    type="action"
                                    string="Sucursales DTE"
                                    class="btn-link"/>
                        </setting>
                        <setting string="Auto Enviar Consumo de Folios" help="Enviar automáticamente consumo de folios">
                            <field name="cf_autosend"/>
                        </setting>
                    </block>

                    <!-- External Services Integration -->
                    <block title="Integración con Servicios Externos" name="fe_external_services_block">
                        <setting string="URL Remote Partners" help="URL de consulta de partners (autollenado)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="url_remote_partners" class="col-lg-4 o_light_label"/>
                                    <field name="url_remote_partners"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Token Remote Partners" help="Token de consulta de partners">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="token_remote_partners" class="col-lg-4 o_light_label"/>
                                    <field name="token_remote_partners" password="True"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Sincronizar Partners" help="Sincronizar datos con base de datos maestra">
                            <field name="sync_remote_partners"/>
                        </setting>
                    </block>

                    <!-- API CAF -->
                    <block title="API Emisión de Folios" name="fe_api_caf_block">
                        <setting string="URL API Emisión Folios" help="URL API para emisión de folios">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="url_apicaf" class="col-lg-4 o_light_label"/>
                                    <field name="url_apicaf"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Token API Emisión Folios" help="Token API para emisión de folios">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="token_apicaf" class="col-lg-4 o_light_label"/>
                                    <field name="token_apicaf" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="trafquin (XML, Registro de Compras y Ventas y propuesta F29 desde el SII)" name="fe_trafquin_block">
                        <setting id="trafquin" string="trafquin" help="Consulta en el SII el respaldo de XML, el Registro de Compras y Ventas, el libro de boletas y la propuesta de F29">
                            <div class="content-group" name="trafquin_right_pane">
                                <div class="row mt16">
                                    <label for="url_trafquin" string="URL" class="col-lg-4 o_light_label"/>
                                    <field name="url_trafquin" placeholder="https://trafquin.ejemplo.cl"/>
                                </div>
                                <div class="row mt8">
                                    <label for="token_trafquin" string="Token" class="col-lg-4 o_light_label"/>
                                    <field name="token_trafquin" password="True"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="trafquin_sistema_xml" string="Sistema de facturación de la compañía" help="Con el sistema MIPYME el SII guarda los XML recibidos y se descargan por documento. Con software propio el XML de un documento recibido solo llega por correo del emisor. Vacío: se deduce de la configuración DTE o de trafquin.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="sii_sistema_xml"/>
                                </div>
                                <div class="text-muted mt8" invisible="not sii_sistema_xml_aviso">
                                    <field name="sii_sistema_xml_aviso"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="trafquin_clave_sii" string="Clave SII de la compañía" help="Para la propuesta de F29 cuando el certificado es de un representante. Sin clave se usa el certificado." groups="base.group_system">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="sii_clave_tributaria" string="Clave" class="col-lg-4 o_light_label"/>
                                    <field name="sii_clave_tributaria" password="True"/>
                                </div>
                                <div class="text-warning mt8" invisible="not sii_clave_aviso">
                                    <field name="sii_clave_aviso"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Contabilización del F29" name="fe_f29_asiento_block" groups="base.group_system">
                        <setting id="f29_asiento" string="Cuentas del asiento F29" help="El asiento de la Declaración Mensual F29 usa estos valores. La cuenta F29 por pagar debe ser de tipo Por pagar, para registrar el pago. Si la Tesorería queda vacía, se crea con RUT 60.805.000-0.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="f29_cuenta_debito_id" class="col-lg-5 o_light_label"/>
                                    <field name="f29_cuenta_debito_id" domain="[('deprecated', '=', False)]" options="{'no_create': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="f29_cuenta_credito_id" class="col-lg-5 o_light_label"/>
                                    <field name="f29_cuenta_credito_id" domain="[('deprecated', '=', False)]" options="{'no_create': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="f29_cuenta_remanente_id" class="col-lg-5 o_light_label"/>
                                    <field name="f29_cuenta_remanente_id" domain="[('deprecated', '=', False)]" options="{'no_create': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="f29_cuenta_ppm_id" class="col-lg-5 o_light_label"/>
                                    <field name="f29_cuenta_ppm_id" domain="[('deprecated', '=', False)]" options="{'no_create': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="f29_cuenta_retencion_id" class="col-lg-5 o_light_label"/>
                                    <field name="f29_cuenta_retencion_id" domain="[('deprecated', '=', False)]" options="{'no_create': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="f29_cuenta_impuesto_unico_id" class="col-lg-5 o_light_label"/>
                                    <field name="f29_cuenta_impuesto_unico_id" domain="[('deprecated', '=', False)]" options="{'no_create': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="f29_cuenta_por_pagar_id" class="col-lg-5 o_light_label"/>
                                    <field name="f29_cuenta_por_pagar_id" domain="[('account_type', '=', 'liability_payable')]" options="{'no_create': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="f29_cuenta_recargo_id" class="col-lg-5 o_light_label"/>
                                    <field name="f29_cuenta_recargo_id" domain="[('deprecated', '=', False)]" options="{'no_create': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="f29_cuenta_reajuste_id" class="col-lg-5 o_light_label"/>
                                    <field name="f29_cuenta_reajuste_id" domain="[('deprecated', '=', False)]" options="{'no_create': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="f29_cuenta_postergado_id" class="col-lg-5 o_light_label"/>
                                    <field name="f29_cuenta_postergado_id" domain="[('deprecated', '=', False)]" options="{'no_create': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="f29_diario_id" class="col-lg-5 o_light_label"/>
                                    <field name="f29_diario_id" domain="[('type', '=', 'general')]" options="{'no_create': True}"/>
                                </div>
                                <div class="row mt8">
                                    <label for="f29_tesoreria_id" class="col-lg-5 o_light_label"/>
                                    <field name="f29_tesoreria_id"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <!-- Indicadores económicos -->
                    <block title="Indicadores Económicos (CMF)" name="fe_cmf_block">
                        <setting string="UF, UTM, dólar y euro" help="Actualización diaria desde la API de la CMF (ex SBIF). La clave se pide en api.cmfchile.cl">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="sbif_token" class="col-lg-4 o_light_label"/>
                                    <field name="sbif_token" password="True"/>
                                </div>
                                <div class="row mt8">
                                    <label for="sbif_url" class="col-lg-4 o_light_label"/>
                                    <field name="sbif_url"/>
                                </div>
                                <div class="mt8">
                                    <button name="action_update_currencies" type="object" string="Actualizar ahora" icon="oi-arrow-right" class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

    <record id="action_dte_config" model="ir.actions.act_window">
        <field name="name">Configuraciones DTE</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'l10n_cl_fe'}</field>
    </record>

    <menuitem id="menu_account_config"
              name="Configuraciones DTE"
              parent="account.menu_finance_configuration"
              sequence="0"
              action="action_dte_config"
              groups="base.group_system"/>

</odoo>
