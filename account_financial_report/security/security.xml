<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.access" id="account_age_report_configuration_rule">
        <field name="name">Account age report configuration rule</field>
        <field name="model_id" ref="model_account_age_report_configuration" />
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record model="ir.access" id="account_group_comp_rule">
        <field name="name">Account Group multi-company</field>
        <field name="model_id" ref="model_account_group" />
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'parent_of', company_ids)]</field>
    </record>
</odoo>
