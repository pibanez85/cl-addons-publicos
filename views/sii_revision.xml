    <record id="view_sii_revision_f29_enviar_form" model="ir.ui.view">
        <field name="name">sii.revision.f29.enviar.form</field>
        <field name="model">sii.revision.f29.enviar</field>
        <field name="arch" type="xml">
            <form string="Llevar ajustes de la propuesta al SII">
                <p>
                    Se guardarán en la propuesta de F29 del SII estos cambios (código: valor SII → valor nuevo, motivo).
                    No se presenta ni se declara el F29.
                </p>
                <field name="revision_id" invisible="1" />
                <field name="resumen" readonly="1" />
                <footer>
                    <button name="action_confirmar" string="Confirmar y llevar al SII" type="object" class="btn-primary" />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_sii_revision_periodo_search" model="ir.ui.view">
        <field name="name">sii.revision.periodo.search</field>
        <field name="model">sii.revision.periodo</field>
        <field name="arch" type="xml">
            <search>
                <field name="periodo" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter name="sin_consultar" string="Sin consultar" domain="[('estado', '=', 'sin_consultar')]" />
                <filter name="fuera_actividades" string="Antes del inicio de actividades" domain="[('estado', '=', 'fuera_actividades')]" />
                <filter name="error" string="Con error" domain="[('estado', '=', 'error')]" />
                <filter name="descuadrado" string="Descuadrados" domain="[('estado', '=', 'descuadrado')]" />
                <filter name="por_declarar" string="Sin declarar, vencidos" domain="[('estado', '=', 'por_declarar')]" />
                <filter name="en_plazo" string="Por declarar" domain="[('estado', '=', 'en_plazo')]" />
                <filter name="fuera_plazo" string="Declarados fuera de plazo" domain="[('estado', '=', 'fuera_plazo')]" />
                <filter name="declarado" string="Declarados sin pago en Odoo" domain="[('estado', '=', 'declarado')]" />
                <filter name="pagado" string="Pagados" domain="[('estado', '=', 'pagado')]" />
                <separator />
                <filter name="rcv_pendiente" string="RCV no conciliado" domain="[('rcv_estado', '!=', 'conciliado')]" />
                <filter name="sin_asiento" string="Sin asiento F29" domain="[('contable_estado', '=', 'sin_asiento')]" />
                <group>
                    <filter name="por_compania" string="Compañía" context="{'group_by': 'company_id'}" groups="base.group_multi_company" />
                    <filter name="por_anio" string="Año" context="{'group_by': 'anio'}" />
                    <filter name="por_estado" string="Estado" context="{'group_by': 'estado'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_sii_revision_periodo" model="ir.actions.act_window">
        <field name="name">Declaración Mensual F29</field>
        <field name="res_model">sii.revision.periodo</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_sii_revision_periodo"
        action="action_sii_revision_periodo"
        parent="account.menu_finance"
        sequence="4"
        groups="account.group_account_invoice"
    />

    <data noupdate="1">
        <record id="ir_cron_sii_revision_mensual" model="ir.cron">
            <field name="name">Declaración Mensual F29 con el SII (propuesta, RCV y boletas)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now().replace(day=1, hour=10, minute=0, second=0) + relativedelta(months=1)).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="model_id" ref="model_sii_revision_periodo" />
            <field name="state">code</field>
            <field name="code">model._cron_revision_mensual()</field>
            <field name="active" eval="True" />
        </record>
        <record id="ir_cron_sii_rcv_diario" model="ir.cron">
            <field name="name">Declaración Mensual F29: conciliar RCV del mes corrido con el SII</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).replace(hour=9, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="model_id" ref="model_sii_revision_periodo" />
            <field name="state">code</field>
            <field name="code">model._cron_rcv_diario()</field>
            <field name="active" eval="True" />
        </record>
    </data>
    <record id="view_account_payment_register_form_f29" model="ir.ui.view">
        <field name="name">account.payment.register.form.f29</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form" />
        <field name="arch" type="xml">
            <field name="communication" position="after">
                <field name="f29_revision_id" invisible="1" />
                <field name="f29_recargo" invisible="not f29_revision_id" />
            </field>
        </field>
    </record>
</odoo>
