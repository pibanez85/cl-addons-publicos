<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="electronic_consumo_folios_tree" model="ir.ui.view">
            <field name="name">l10n_cl_fe.libro_compra_venta.tree</field>
            <field name="model">account.move.consumo_folios</field>
            <field name="arch" type="xml">
                <list decoration-info="sii_result == 'draft'" decoration-muted="sii_result == 'cancel'">
                    <field name="name" />
                    <field name="correlativo" />
                    <field name="fecha_inicio" />
                    <field name="fecha_final" />
                    <field name="date" />
                    <field name="total_boletas" />
                    <field name="total_neto" />
                    <field name="total_iva" />
                    <field name="total_exento" />
                    <field name="total" />
                    <field name="currency_id" invisible="True" />
                    <field name="date" />
                    <field name="company_id" />
                    <field name="sii_result" widget="badge" decoration-muted="sii_result in ['draft', 'NoEnviado', 'Anulado']" decoration-info="sii_result in ['Enviado', 'EnProceso']" decoration-success="sii_result == 'Proceso'" decoration-danger="sii_result == 'Rechazado'" decoration-warning="sii_result == 'Reparo'"/>
                </list>
            </field>
        </record>
        <record id="view_cf_filter" model="ir.ui.view">
            <field name="name">account.move.consumo_folios.list.select</field>
            <field name="model">account.move.consumo_folios</field>
            <field name="arch" type="xml">
                <search string="Buscar Consumo de Folios">
                    <field name="name" />
                    <field name="fecha_inicio" />
                    <field name="sii_result" />
                    <filter name="filter_by_process" string="Procesado" domain="[('sii_result', '=','Proceso')]" />
                    <filter name="filter_by_rejected" string="Rechazado" domain="[('sii_result', '=', 'Rechazado')]" />
                    <filter name="filter_by_cancel" string="Anulado" domain="[('sii_result', '=', 'Anulado')]" />
                    <filter name="filter_by_done" string="Posted" domain="[('sii_result', '=', 'done')]" />
                    <group>
                        <filter
                            name="group_by_fecha"
                            string="Consumos Mensuales Válidos"
                            domain="[('sii_result', '=', 'Proceso')]"
                            context="{'group_by': 'fecha_inicio'}"
                        />
                        <filter string="Estado" name="group_by_state" domain="[]" context="{'group_by': 'sii_result'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="view_electronic_consumo_folios_form" model="ir.ui.view">
            <field name="name">l10n_cl_fe.consumo_folios.form</field>
            <field name="model">account.move.consumo_folios</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button
                            name="validar_consumo_folios"
                            type="object"
                            string="Validate"
                            invisible="sii_result != 'draft'"
                            class="oe_highlight"
                            groups="base.group_user"
                        />
                        <button
                            string="Download XML"
                            type="object"
                            name="get_xml_file"
                            invisible="sii_result in ['draft','NoEnviado']"
                        />
                        <button
                            string="Send XML"
                            type="object"
                            class="oe_highlight"
                            name="do_dte_send_now"
                            invisible="sii_result not in ['NoEnviado']"
                        />
                        <button
                            string="Ask for DTE"
                            type="object"
                            class="oe_highlight"
                            name="ask_for_dte_status"
                            invisible="sii_result in ['draft','NoEnviado']"
                        />
                        <field name="sii_result" widget="statusbar" />
                    </header>
                    <group>
                        <field name="name" force_save="1" />
                        <field name="fecha_inicio" readonly="sii_result != 'draft'" />
                        <field name="fecha_final" force_save="1" />
                        <field name="sec_envio" force_save="1" />
                        <field name="date" />
                        <field name="company_id" />
                        <field name="currency_id" invisible="True" force_save="True" />
                        <field name="total_neto" />
                        <field name="total_boletas" />
                        <field name="total_iva" />
                        <field name="total_exento" />
                        <field name="total" />
                    </group>
                    <group>
                        <field name="impuestos" options="{'no_open': True, 'no_create': True}">
                            <list>
                                <field name="tpo_doc" />
                                <field name="monto_neto" />
                                <field name="monto_iva" />
                                <field name="monto_exento" />
                                <field name="monto_total" />
                            </list>
                        </field>
                        <field name="detalles">
                            <list>
                                <field name="cf_id" invisible="True" />
                                <field name="tipo_operacion" />
                                <field name="folio_inicio" />
                                <field name="folio_final" />
                                <field name="cantidad" />
                                <field name="tpo_doc" />
                            </list>
                        </field>
                    </group>
                    <notebook>
                        <page string="Movimientos">
                            <field name="move_ids" editable="bottom" widget="many2many_list">
                              <form>
                                <field name="name" />
                                <field name="date" />
                                <field name="line_ids" widget="one2many_list">
                                    <list editable="bottom" string="Journal Items">
                                        <field name="debit" sum="Total Debit" />
                                        <field name="credit" sum="Total Credit" />
                                    </list>
                                </field>
                              </form>
                            </field>
                        </page>
                        <page string="Anulaciones Manuales de Folio">
                            <group>
                                <field name="anulaciones" editable="bottom" widget="one2many">
                                    <list editable="bottom">
                                        <field name="tpo_doc" />
                                        <field name="rango_inicio" />
                                        <field name="rango_final" />
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Envio SII">
                            <group>
                                <field name='sii_xml_request' readonly="True" />
                            </group>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>
        <record id="action_move_consumo_folios" model="ir.actions.act_window">
            <field name="name">Consumo de Folios</field>
            <field name="res_model">account.move.consumo_folios</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="electronic_consumo_folios_tree" />
            <field name="search_view_id" ref="view_cf_filter" />
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
                Click para Crear un Consumo de Folios.
              </p>
              <p>
                El Consumo de Folios concentra los documentos de tipo 39, 41, y NC boletas para el día seleccionado
              </p>
              <p>
                Los documentos son seleccionados automáticamente una vez seleccionado el día de inicio y final
              </p>
            </field>
        </record>

        <menuitem
            action="action_move_consumo_folios"
            id="menu_action_move_consumo_folios_form"
            parent="account.menu_finance_reports"
            groups="account.group_account_manager"
            sequence="3"
        />
    </data>
</odoo>
