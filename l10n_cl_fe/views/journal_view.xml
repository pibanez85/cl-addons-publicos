<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_account_journal_cl_filter" model="ir.ui.view">
            <field name="model">account.journal</field>
            <field name="name">account.journal.cl.filter</field>
            <field name="inherit_id" ref="account.view_account_journal_search" />
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="sii_code" />
                    <field name="sucursal_id" />
                </field>
            </field>
        </record>
        <record id="account_journal_tree_view" model="ir.ui.view">
            <field name="name">account.journal.tree</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_tree" />
            <field name="arch" type="xml">
                <field name="type" position="after">
                    <field name="sucursal_id" />
                </field>
            </field>
        </record>
        <record id="view_account_journal_cl_form" model="ir.ui.view">
            <field name="model">account.journal</field>
            <field name="name">account.journal.cl.form</field>
            <field name="inherit_id" ref="account.view_account_journal_form" />
            <field name="arch" type="xml">
                <field name="refund_sequence" position="before">
                  <field name="default_gd_account_id" invisible="type not in ['purchase', 'sale']" />
                  <field name="default_gr_account_id" invisible="type not in ['purchase', 'sale']" />
                  <field name="default_comision_account_id" invisible="type not in ['purchase', 'sale']" />
                </field>

                <field name="type" position="after">
                    <field name="sucursal_id" invisible="not use_documents" />
                    <field name="sii_code" invisible="not use_documents" />
                    <field name="use_documents" invisible="type not in ['purchase', 'sale']" />
                    <field name="restore_mode" invisible="not use_documents" />
                    <field name="sii_declara_ventas" invisible="type != 'bank'" />
                    <field name="sii_canal_48" invisible="not sii_declara_ventas" required="sii_declara_ventas" />
                </field>

                <notebook position="inside">
                    <page
                        string="Documents"
                        invisible="not use_documents"
                    >
                        <button
                            name="%(action_account_journal_document_config_form)d"
                            string="Create Journal Documents"
                            type="action"
                            class="oe_highlight"
                            context="{'type':type}"
                        />
                        <button
                            name="%(action_apicaf_form)d"
                            invisible="not journal_document_class_ids"
                            string="Obtener Folios desde el SII"
                            type="action"
                            context="{'default_company_id': company_id,
                                    'default_documentos': journal_document_class_ids}"
                            class="btn-primary"
                        />
                        <group>
                            <field name="company_activity_ids" invisible="True" />
                            <field
                                name="journal_activities_ids"
                                invisible="not journal_document_class_ids"
                                required="use_documents and journal_document_class_ids"
                                placeholder="Giros del Diario"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                                domain="[('id', 'in', company_activity_ids)]"
                            />
                        </group>
                        <field
                            name="document_class_ids"
                            invisible="type != 'purchase'"
                            widget="many2many_tags"
                            options="{'no_open': True, 'no_create': True}"
                        />
                        <field
                            name='journal_document_class_ids'
                            context="{'journal_type': type}"
                            invisible="not journal_document_class_ids and type == 'purchase'"
                            editable="bottom"
                            widget="one2many"
                        >
                            <tree string="Journal SII Documents" editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="is_dte" invisible="1" />
                                <field name="sii_document_class_id" options="{'no_open': True, 'no_create': True}" domain="['|', ('dte', '=', True), ('sii_code', '=', 48)]" />
                                <field
                                    name='sequence_id'
                                    context="{'default_sii_document_class_id': sii_document_class_id, 'is_dte': True}"
                                    domain="[('is_dte', '=', True)]"
                                    readonly="not is_dte"
                                    required="is_dte"
                                />
                                <field name="qty_available" readonly="1" />
                            </tree>
                        </field>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
