<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">view_order_form.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="partner_shipping_id" position="before">
                <field name="acteco_ids" invisible="True" />
                <field
                    name="acteco_id"
                    invisible="not acteco_ids"
                    domain="[('id', 'in', acteco_ids)]"
                    options="{'no_open': True, 'no_create': True}"
                />
            </field>

            <page name="other_information" position="after">
              <page string="Referencias DTE">
                <field name="referencia_ids" mode="list">
                    <list editable="bottom">
                        <field name="fecha_documento" />
                        <field name="folio" required="True" />
                        <field name="ref_id" required="True" />
                        <field name="motivo" />
                    </list>
                </field>
              </page>
            </page>

            <field name="payment_term_id" position="after">
                <field name="convert_to_company_currency" readonly="(state == 'cancel' or invoice_count != 0) and state in ('sale', 'done', 'cancel')" groups="base.group_multi_currency"/>
            </field>

            <label for="fiscal_position_id" position="before">
              <field name="journal_id" options="{'no_create': True}"/>
              <field name="use_documents" />
              <field name="document_class_ids" invisible="True"/>
              <field name="journal_document_class_id" options="{'no_create': True}" invisible="not use_documents"/>
            </label>
        </field>
    </record>
</odoo>
