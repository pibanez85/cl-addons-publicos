<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="voucher_factura_report_view_pivot" model="ir.ui.view">
        <field name="name">l10n_cl.voucher.factura.report.pivot</field>
        <field name="model">l10n_cl.voucher.factura.report</field>
        <field name="arch" type="xml">
            <pivot string="Pagos electrónicos de facturas" sample="1">
                <field name="date" interval="day" type="row"/>
                <field name="canal" type="col"/>
                <field name="documentos" type="measure"/>
                <field name="monto_total" type="measure"/>
                <field name="monto_neto" type="measure"/>
                <field name="monto_iva" type="measure"/>
                <field name="monto_exento" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="voucher_factura_report_view_list" model="ir.ui.view">
        <field name="name">l10n_cl.voucher.factura.report.list</field>
        <field name="model">l10n_cl.voucher.factura.report</field>
        <field name="arch" type="xml">
            <list string="Pagos electrónicos de facturas">
                <field name="date"/>
                <field name="canal"/>
                <field name="document_class_id"/>
                <field name="folio"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="pago" optional="hide"/>
                <field name="origen" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="documentos" sum="Total"/>
                <field name="monto_total" sum="Total"/>
                <field name="monto_neto" sum="Total"/>
                <field name="monto_iva" sum="Total"/>
                <field name="monto_exento" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="voucher_factura_report_view_search" model="ir.ui.view">
        <field name="name">l10n_cl.voucher.factura.report.search</field>
        <field name="model">l10n_cl.voucher.factura.report</field>
        <field name="arch" type="xml">
            <search string="Pagos electrónicos de facturas">
                <field name="move_id"/>
                <field name="folio"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <filter name="filter_date" date="date" default_period="this_month" string="Periodo"/>
                <separator/>
                <filter name="canal_presencial" string="Presencial" domain="[('canal', '=', 'presencial')]"/>
                <filter name="canal_internet" string="Internet" domain="[('canal', '=', 'internet')]"/>
                <group>
                    <filter name="group_day" string="Día" context="{'group_by': 'date:day'}"/>
                    <filter name="group_canal" string="Canal" context="{'group_by': 'canal'}"/>
                    <filter name="group_journal" string="Medio de pago" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_origen" string="Origen" context="{'group_by': 'origen'}"/>
                    <filter name="group_document_class" string="Tipo de documento" context="{'group_by': 'document_class_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_voucher_factura_report" model="ir.actions.act_window">
        <field name="name">Pagos electrónicos de facturas</field>
        <field name="res_model">l10n_cl.voucher.factura.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="voucher_factura_report_view_search"/>
        <field name="context">{'search_default_filter_date': 1, 'search_default_group_day': 1, 'search_default_group_canal': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Sin pagos electrónicos de facturas en el periodo</p>
            <p>Pagos con medios electrónicos de facturas de empresas en modelo voucher. Rebajar en el RCV, tipo «Total mes Comprobantes Pago Electrónico (48)», día por día y por canal, con la razón «Ventas son respaldadas por facturas».</p>
        </field>
    </record>

    <menuitem id="menu_voucher_factura_report"
              name="Pagos electrónicos de facturas"
              parent="account.account_reports_management_menu"
              action="action_voucher_factura_report"
              sequence="6"/>
</odoo>
