<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="sii_sucursal_form_view" model="ir.ui.view">
            <field name="name">sii.sucursal.form</field>
            <field name="model">sii.sucursal</field>
            <field name="arch" type="xml">
                <form string="Sucursales">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="sii_code" />
                            </group>
                            <group>
                                <field name="partner_id" />
                                <field
                                    name="company_id"
                                    groups="base.group_multi_company"
                                    options="{'no_create': True, 'no_open': True}"
                                />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="sii_sucursal_tree_view" model="ir.ui.view">
            <field name="name">sii.sucursal.tree</field>
            <field name="model">sii.sucursal</field>
            <field name="arch" type="xml">
                <tree string="Sucursales">
                    <field name="name" />
                    <field name="sii_code" />
                    <field name="partner_id" />
                    <field name="company_id" groups="base.group_multi_company" />
                </tree>
            </field>
        </record>
        <record id="action_sii_sucursal" model="ir.actions.act_window">
            <field name="name">Sucursales DTE</field>
            <field name="res_model">sii.sucursal</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record model="ir.actions.act_window.view" id="action_sii_sucursal_tree">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="sii_sucursal_tree_view"/>
            <field name="act_window_id" ref="action_sii_sucursal"/>
        </record>
        <record model="ir.actions.act_window.view" id="action_sii_sucursal_form">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="sii_sucursal_form_view"/>
            <field name="act_window_id" ref="action_sii_sucursal"/>
        </record>
    </data>
</odoo>
