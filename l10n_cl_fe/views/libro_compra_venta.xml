<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="electronic_book_compra_venta_tree" model="ir.ui.view">
            <field name="name">l10n_cl_fe.libro_compra_venta.tree</field>
            <field name="model">account.move.book</field>
            <field name="arch" type="xml">
                <list
                    decoration-info="sii_result == 'draft'"
                    decoration-muted="sii_result == 'cancel'"
                    decoration-danger="sii_result == 'Rechazado'"
                >
                    <field name="name" />
                    <field name="tipo_operacion" />
                    <field name="tipo_libro" />
                    <field name="periodo_tributario" />
                    <field name="date" />
                    <field name="company_id" />
                    <field name="sii_result" />
                </list>
            </field>
        </record>
        <record id="view_electronic_book_compra_venta_form" model="ir.ui.view">
            <field name="name">l10n_cl_fe.libro_compra_venta.form</field>
            <field name="model">account.move.book</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button
                            type="object"
                            name="validar_libro"
                            invisible="sii_result != 'draft'"
                            string="Validate"
                            class="oe_highlight"
                            groups="base.group_user"
                        />
                        <button
                            string="Download XML"
                            type="object"
                            name="get_xml_file"
                            invisible="sii_result in ['draft']"
                        />
                        <button
                            string="Send XML"
                            type="object"
                            class="oe_highlight"
                            name="do_dte_send_now"
                            invisible="sii_result not in ['NoEnviado']"
                        />
                        <button
                            string="Ask for DTE"
                            type="object"
                            class="oe_highlight"
                            name="ask_for_dte_status"
                            invisible="sii_result in ['draft','NoEnviado']"
                        />
                        <field name="sii_result" widget="statusbar" />
                    </header>
                    <group>
                        <field name="name" readonly="sii_result != 'draft'" />
                        <field name="date" readonly="sii_result != 'draft'" />
                        <field name="company_id" readonly="sii_result != 'draft'" />
                        <field name="currency_id" invisible="True" />
                        <field name="total_afecto" invisible="True" />
                        <field name="total_iva" invisible="True" />
                        <field name="total_exento" invisible="True" />
                        <field name="total_otros_imps" invisible="True" />
                        <field name="total" invisible="True" />
                        <field name="periodo_tributario" readonly="sii_result != 'draft'" />
                        <field name="tipo_operacion" readonly="sii_result != 'draft'" />
                        <field name="tipo_libro" readonly="sii_result != 'draft'" />
                        <field name="tipo_envio" readonly="sii_result != 'draft'" />
                        <field
                            name="folio_notificacion" readonly="sii_result != 'draft'"
                            invisible="tipo_libro not in ['ESPECIAL']"
                            required="tipo_libro in ['ESPECIAL']"
                        />
                        <field
                            name="codigo_rectificacion"
                            invisible="tipo_libro not in ['RECTIFICA']"
                            required="tipo_libro in ['RECTIFICA']"
                        />
                        <field name="fact_prop" readonly="sii_result != 'draft'" />
                    </group>
                    <group>
                        <field
                            name="impuestos"
                            options="{'no_edit': True}"
                            context="{'tipo_operacion': tipo_operacion}"
                        >
                            <list>
                                <field name="tax_id" />
                                <field name="debit" />
                                <field name="credit" />
                                <field name="amount" />
                                <field name="currency_id" invisible="True" />
                                <field name="book_id" invisible="True" />
                            </list>
                        </field>
                    </group>
                    <notebook>
                        <page string="Movimientos">
                            <field
                                name="move_ids" readonly="sii_result != 'draft'"
                                editable="bottom"
                                widget="many2many_list"
                                domain="[('journal_id.type', 'in', ['sale', 'purchase'])]"
                            />
                        </page>
                        <page string="Boletas" invisible="tipo_operacion != 'VENTA'">
                            <p class="text-muted">
                                La línea de comprobantes de pago electrónico (48) no se informa al SII en el libro: solo sirve para conciliar en Odoo.
                            </p>
                            <group>
                                <field name="boletas" readonly="sii_result != 'draft'" widget="one2many">
                                    <list decoration-muted="informativa">
                                        <field name="tipo_boleta" />
                                        <field name="informativa" widget="boolean" optional="show" />
                                        <field name="rango_inicial" />
                                        <field name="rango_final" />
                                        <field name="cantidad_boletas" />
                                        <field name="cantidad_anulados" />
                                        <field name="currency_id" column_invisible="True" />
                                        <field name="neto" />
                                        <field name="monto_exento" />
                                        <field name="impuesto" />
                                        <field name="monto_impuesto" />
                                        <field name="monto_total" />
                                    </list>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="tipo_boleta" />
                                                <field name="rango_inicial" />
                                                <field name="rango_final" />
                                                <field name="cantidad_boletas" />
                                                <field name="cantidad_anulados" />
                                            </group>
                                            <group>
                                                <field name="currency_id" invisible="True" />
                                                <field name="neto" />
                                                <field name="monto_exento" />
                                                <field name="impuesto" />
                                                <field name="monto_impuesto" />
                                                <field name="monto_total" />
                                            </group>
                                        </group>
                                    </form>
                                </field>
                            </group>
                        </page>
                        <page string="Envio SII">
                            <group>
                                <field name='sii_xml_request' readonly="True" />
                            </group>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>
        <record id="action_move_books" model="ir.actions.act_window">
            <field name="name">Libros Cierre de Mes</field>
            <field name="res_model">account.move.book</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="electronic_book_compra_venta_tree" />
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
          Click to create a journal entry.
        </p>
                <p>
          A journal entry consists of several journal items, each of
          which is either a debit or a credit transaction.
        </p>
                <p>
          Odoo automatically creates one journal entry per accounting
          document: invoice, refund, vendor payment, bank statements,
          etc. So, you should record journal entries manually only/mainly
          for miscellaneous operations.
        </p>
            </field>
        </record>

        <menuitem
            action="action_move_books"
            id="menu_action_move_books_form"
            parent="account.menu_finance_reports"
            groups="account.group_account_manager"
            sequence="3"
        />
    </data>
</odoo>
