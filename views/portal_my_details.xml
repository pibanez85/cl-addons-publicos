<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_details" inherit_id="portal.portal_my_details" name="Portal DTE Class">
        <xpath expr="//div[hasclass('o_portal_details')]" position="attributes">
            <attribute name="class" add="l10n_cl_fe" separator=" "/>
        </xpath>
    </template>

    <template id="portal_my_details_fields" inherit_id="portal.portal_my_details_fields" name="Portal DTE Fields">
        <xpath expr="//input[@name='name']" position="attributes">
            <attribute name="class" add="l10n_cl_name" separator=" "/>
        </xpath>
        <xpath expr="//input[@name='email']" position="attributes">
            <attribute name="class" add="l10n_cl_email" separator=" "/>
        </xpath>
        <xpath expr="//select[@name='state_id']" position="attributes">
            <attribute name="class" add="l10n_cl_state" separator=" "/>
        </xpath>
        <xpath expr="//input[@name='street']" position="attributes">
            <attribute name="class" add="l10n_cl_street" separator=" "/>
        </xpath>
        <xpath expr="//input[@name='phone']" position="attributes">
            <attribute name="class" add="l10n_cl_phone" separator=" "/>
        </xpath>
        <xpath expr="//input[@name='zipcode']" position="attributes">
            <attribute name="class" add="l10n_cl_zipcode" separator=" "/>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'name')]" position="after">
            <div t-attf-class="mb-3 #{error.get('document_number') and 'o_has_error' or ''} col-xl-6">
                <label class="col-form-label" for="document_number">RUT</label>
                <input type="text" name="document_number" t-attf-class="form-control l10n_cl_rut l10n_cl_partner_search #{error.get('document_number') and 'is-invalid' or ''}" t-att-value="document_number or partner.document_number" t-att-disabled="None if partner_can_edit_vat else '1'" t-att-readonly="None if partner_can_edit_vat else '1'"/>
                <small t-if="not partner_can_edit_vat" class="form-text text-muted">No se permite cambiar el RUT una vez que se han emitido documentos para su cuenta.</small>
            </div>
            <div t-if="partner.parent_id" t-attf-class="mb-3 col-xl-6">
                <label class="col-form-label">Compañía</label>
                <input type="text" class="form-control" t-att-value="partner.parent_id.name" disabled="1" readonly="1"/>
            </div>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'email')]" position="after">
            <div t-attf-class="mb-3 #{error.get('dte_email') and 'o_has_error' or ''} col-xl-6">
                <label class="col-form-label" for="dte_email">Correo DTE</label>
                <input type="email" name="dte_email" t-attf-class="form-control l10n_cl_dte_email #{error.get('dte_email') and 'is-invalid' or ''}" t-att-value="dte_email or partner.dte_email"/>
            </div>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'state_id')]" position="after">
            <div t-attf-class="mb-3 #{error.get('city_id') and 'o_has_error' or ''} col-xl-6">
                <label class="col-form-label" for="city_id">Comuna</label>
                <select name="city_id" t-attf-class="form-select l10n_cl_city #{error.get('city_id') and 'is-invalid' or ''}">
                    <option value="">Seleccione comuna...</option>
                    <t t-foreach="cities or []" t-as="city">
                        <option t-att-value="city.id" t-att-data-state_id="city.state_id.id" t-att-data-code="city.code" t-att-data-zipcode="city.zipcode" t-att-selected="city.id == selected_city_id">
                            <t t-esc="city.name"/>
                        </option>
                    </t>
                </select>
            </div>
        </xpath>
    </template>
</odoo>
