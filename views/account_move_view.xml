<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_account_invoice_filter" model="ir.ui.view">
            <field name="name">l10n_cl_fe.invoice.search</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter" />
            <field name="arch" type="xml">
                <field name="name" position="attributes">
                    <attribute
                        name="filter_domain"
                    >[  '|', '|' , '|', '|', '|',
                         ('name', 'ilike', self), ('invoice_origin', 'ilike', self),
                         ('ref', 'ilike', self), ('payment_reference', 'ilike', self),
                         ('partner_id', 'child_of', self), ('sii_document_number', 'ilike', self)]</attribute>
                </field>
                <field name="partner_id" position="after">
                    <field name="activity_description" placeholder="Glosa descriptiva" options="{'no_open': True}" />
                    <field name="document_class_id" />
                </field>
                <xpath expr="//filter[@name='status']" position="after">
                    <filter name="document_type" string="Document Type" context="{'group_by':'document_class_id'}" />
                </xpath>
            </field>
        </record>
        <record id="invoice_tree" model="ir.ui.view">
            <field name="name">l10n_cl_fe.invoice.tree</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree" />
            <field name="arch" type="xml">
              <!--
                <field name="origin" position="after">
                    <field name="reference" />
                </field>
              -->
                <field name="name" position="after">
                    <field name="document_class_id" />
                    <field name="sii_document_number" />
                </field>
                <field name="name" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="payment_state" position="after">
                    <field name="sii_result" widget="badge" decoration-muted="sii_result in ['draft', 'NoEnviado', 'Anulado'] or state == 'cancel'" decoration-info="sii_result in ['Enviado', 'EnProceso']" decoration-success="sii_result == 'Proceso'" decoration-danger="sii_result == 'Rechazado'" decoration-warning="sii_result == 'Reparo'"/>
                </field>
            </field>
        </record>

        <record id="view_invoice_form" model="ir.ui.view">
            <field name="model">account.move</field>
            <field name="name">account.move.sii.form</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <form>
                    <field name="document_class_ids" invisible="True" />
                    <field name="sii_code" invisible="True" />
                </form>
                <button name="preview_invoice" position="after">
                    <button string="Imprimir Copia y Cedible" type="object" name="print_copy_cedible" />
                    <button string="Imprimir Cedible" type="object" name="print_cedible" />
                    <button name="action_reverse" string='Agregar Nota de Débito'
                            type='object' groups="account.group_account_invoice"
                            invisible="move_type not in ['out_refund', 'in_refund'] or state != 'posted'"/>
                </button>
                <field name="discount" position="after">
                    <field name="discount_amount" invisible="True" />
                </field>
                <h1 position="replace">
                    <div invisible="state != 'draft' or move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund']">
                      <span class="o_form_label">Emitir Documentos</span>
                      <field name="use_documents" readonly="state != 'draft'"/>
                    </div>
                    <h1>
                        <div
                            invisible="state == 'draft' and use_documents"
                        >
                          <field
                              name="document_class_id"
                              options="{'no_open': True, 'no_create': True}"
                              domain="[('id', 'in', document_class_ids)]"
                              class="oe_inline"
                              readonly="state != 'draft'"
                          />
                      </div>
                      <div
                        invisible="state != 'draft' or not use_documents"
                        >
                          <span class="o_form_label" invisible="state != 'draft'">Siguiente</span>
                          <field
                                    name="journal_document_class_id"
                                    required="use_documents and state == 'draft'"
                                    readonly="state != 'draft'"
                                    options="{'no_create': True}"
                                    domain="[('sii_document_class_id', 'in', document_class_ids), ('journal_id', '=', journal_id)]"
                                    style="width: 100%"
                                /><br /> Número:
                          <field
                                  name="sequence_number_next"
                                  class="oe_inline"
                                  readonly="True"
                                  invisible="sii_document_number &gt;0"
                              />
                      </div>
                      <div invisible="use_documents and sii_document_number == 0">
                        Número:
                        <field
                              name="sii_document_number"
                              class="oe_inline"
                              readonly="state != 'draft'"
                          />
                      </div>
                      <field name="name" readonly="True" invisible="True" class="oe_inline" />
                  </h1>
                </h1>
                <field name='partner_id' position="after">
                    <field name="activity_description" placeholder="Glosa descriptiva" options="{'no_open': True}" invisible="move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund']"/>
                    <field name="acteco_ids" invisible="True" />
                    <field
                        name="acteco_id"
                        invisible="not acteco_ids or move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund']"
                        domain="[('id', 'in', acteco_ids)]"
                        options="{'no_open': True, 'no_create': True}"
                    />
                </field>
                <label for="journal_id" position="before">
                  <label for="forma_pago"
                         groups="account.group_account_readonly"
                         invisible="move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund']"/>
                  <div name="forma_pago_div" class="d-flex" invisible="move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund']">
                    <field name="forma_pago" readonly="state != 'draft'"/>
                  </div>
                  <label for="contact_id"
                         groups="account.group_account_readonly"
                         invisible="move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund']"/>
                  <div name="contact_id_div" class="d-flex" invisible="move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund']">
                    <field name="contact_id" domain="[('parent_id','=',partner_id)]" readonly="state != 'draft'"/>
                  </div>

                </label>
                <field name="invoice_incoterm_id" position="after">
                  <field name="iva_uso_comun" invisible="move_type not in ['in_invoice', 'in_refund']" readonly="state != 'draft'"/>
                  <field name="no_rec_code" invisible="move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund']" readonly="state != 'draft'"/>
                </field>
                <field name="product_id" position="before">
                  <field name="tpo_doc_liq" optional="hide"/>
                </field>
                <field name="tax_ids" position="before">
                  <field name="ind_exe" optional="hide"/>
                </field>
                <xpath expr="//group[hasclass('oe_invoice_lines_tab')]" position="after">
                    <field
                        name="global_descuentos_recargos"
                        widget="one2many_list"
                        mode="tree"
                        context="{'default_move_id': active_id}"
                        nolabel="1"
                        readonly="state != 'draft'"
                    >
                        <tree string="Descuetos / Recargos Globales" editable="bottom">
                            <field name="type" />
                            <field name="gdr_type" />
                            <field name="valor" />
                            <field name="gdr_detail" />
                            <field name="impuesto" />
                            <field name="amount_untaxed" />
                            <field name="amount" />
                            <field name="account_id"/>
                            <field name="aplicacion" />
                            <field name="move_id" invisible="True" />
                            <field name="company_id" invisible="True" />
                        </tree>
                    </field>
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree/field[@name='account_type']" position="before">
                    <field name="is_gd_line" invisible="True"/>
                    <field name="is_gr_line" invisible="True"/>
                </xpath>
                <page id="other_tab" position="after">
                  <page id="referencias" string="Referencias" invisible="move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund']">
                    <group>
                      <field name="referencias" mode="tree" readonly="state != 'draft'">
                          <form>
                              <group>
                                  <field name="sequence" widget="handle" />
                                  <field name="origen" required="True" />
                                  <field name="sii_referencia_TpoDocRef" required="True" />
                                  <field name="sii_referencia_CodRef" />
                                  <field name="motivo" />
                                  <field name="fecha_documento" />
                              </group>
                          </form>
                          <tree editable="bottom">
                              <field name="sequence" widget="handle" />
                              <field name="origen" required="True" />
                              <field name="sii_referencia_TpoDocRef" required="True" />
                              <field name="sii_referencia_CodRef" />
                              <field name="motivo" />
                              <field name="fecha_documento" />
                          </tree>
                      </field>
                    </group>
                  </page>
                  <page string="Comisiones Liquidación Factura" name="liquidacion"  invisible="sii_code not in [43, 46]">
                      <group>
                          <field name="comision_ids" editable="bottom" widget="one2many" readonly="state != 'draft'">
                            <tree editable="top/bottom">
                              <field name="sequence" widget="handle" />
                              <field name="name" />
                              <field name="currency_id" invisible="True" />
                              <field name="tipo_movimiento" required="True"/>
                              <field name="tasa_comision" />
                              <field name="valor_neto_comision" />
                              <field name="valor_exento_comision" />
                              <field name="valor_iva_comision" />
                              <field name="move_id" invisible="True" />
                            </tree>
                          </field>
                      </group>
                  </page>
                </page>

                <group name="sale_info_group" position="inside">
                    <field name="ticket" readonly="state != 'draft'"/>
                    <field name="ind_servicio" readonly="state != 'draft'"/>
                </group>
                <notebook>
                    <page
                        string="Electronic Invoice"
                        name="electronic_invoice"
                        invisible="not use_documents"
                    >
                        <header>
                            <button
                                string="Download XML"
                                type="object"
                                name="get_xml_file"
                                invisible="state in ['draft'] or not sii_xml_request"
                            />
                            <button
                                string="Download XML Exchange"
                                type="object"
                                name="get_xml_exchange_file"
                                invisible="state in ['draft'] or  not sii_xml_request"
                            />
                            <button
                                string="Envío Manual XML Intercambio"
                                type="object"
                                name="manual_send_exchange"
                                invisible="state in ['draft'] or not sii_xml_request"
                            />
                            <button
                                string="Send XML"
                                type="object"
                                class="oe_highlight"
                                name="do_dte_send_invoice"
                                invisible="state in ['draft'] or sii_result not in ['','NoEnviado','Rechazado']"
                            />
                            <button
                                string="Ask for DTE"
                                type="object"
                                class="oe_highlight"
                                name="ask_for_dte_status"
                                invisible="state in ['draft'] or sii_result in ['','NoEnviado']"
                            />
                            <field name='sii_result' widget="statusbar" />
                        </header>
                        <group>
                            <field
                                name='sii_xml_request'
                                invisible="not sii_result"
                                options="{'no_create': True}"
                            />
                            <field name='sii_batch_number' readonly="True" />
                            <field
                                name='sii_barcode_img'
                                widget="image"
                                invisible="not sii_result"
                                readonly="True"
                            />
                            <field
                                name='sii_message'
                                invisible="sii_result in ['','NoEnviado']"
                                readonly="True"
                            />
                            <field name='sii_xml_dte' invisible="not sii_result" readonly="True" />
                        </group>
                    </page>
                    <page
                        name="client_claim"
                        string="Registro de Reclamo en SII"
                        invisible="not use_documents or sii_result in [False, '', 'NoEnviado', 'Rechazado']"
                    >
                        <header>
                            <button name="get_dte_claim" string="Consultar estado de Reclamo" type="object" />
                            <field name='claim' widget="statusbar" />
                        </header>
                        <group>
                            <field name="claim_description" />
                        </group>
                    </page>
                    <page
                        name="client_reception"
                        string="Respuesta Cliente"
                        invisible="not use_documents or sii_result in [False, '', 'NoEnviado', 'Rechazado']"
                    >
                        <group string="La respuesta puede variar, todo depende de si el cliente cumple con darla">
                            <field name="respuesta_ids" mode="tree">
                                <tree>
                                    <field name="type" />
                                </tree>
                            </field>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
